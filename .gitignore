# Quant Trader — Git忽略规则
# 敏感文件
.env
.env.example      # 模板不含真实密钥，但可忽略
*.token
*_token*
quant_trading/.env
deepcode_config.json   # 含 ${VAR} 占位符或真实密钥

# 数据库 (包含真实交易数据)
*.db
*.db-journal
*.db-wal
*.db-shm
!test_*.db

# 日志
logs/
*.log
*.jsonl

# 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.pyc.bak

# 日志 (运行时生成)
logs/
*.jsonl
!quant_trading/logs/.gitkeep
!quant_trading/logs/filebeat.yml
!quant_trading/logs/logstash.conf

# 报告 (含个人信息)
reports/*.docx
reports/*.html
charts/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 环境
.venv/
venv/
env/

# 第三方/大型二进制目录
claude-code-win32-x64/
devecostudio-windows-6.1.1.280/
dzh365/
node_modules/
deveco_extract/
OpenHarmony/
Huawei/
nvidia-skills/
CAD/
.cn-financial-mcp/
nanobot/              # 原框架，已移植到 core/
cn-financial-mcp/     # 独立 MCP 服务，通过 settings.json 引用
eval/                 # 评估框架

# 数据文件 (大型)
data/*.h5
data/*.parquet
data/*.feather

# OS
.DS_Store
Thumbs.db

# 报告缓存
reports/*.json
reports/*.docx
reports/*.txt
